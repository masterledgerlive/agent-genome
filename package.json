{
  "name": "agent-genome",
  "version": "1.0.0",
  "description": "Extract, compress, and inject LLM parameters into blockchains. Decentralized AGI on-chain.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/cli/index.ts",
    "build": "tsc && esbuild src/cli/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "extract": "tsx src/cli/extract.ts",
    "compress": "tsx src/cli/compress.ts",
    "inject": "tsx src/cli/inject.ts",
    "retrieve": "tsx src/cli/retrieve.ts",
    "run": "tsx src/cli/run.ts",
    "cost-analysis": "tsx src/cli/cost-analysis.ts",
    "find-agents": "tsx src/cli/find-agents.ts"
  },
  "dependencies": {
    "ethers": "^6.10.0",
    "@solana/web3.js": "^1.90.0",
    "axios": "^1.12.0",
    "dotenv": "^17.2.2",
    "zod": "^4.1.12",
    "nanoid": "^5.1.5",
    "pino": "^8.17.2",
    "transformers": "^2.6.0",
    "onnxruntime-node": "^1.16.0",
    "sharp": "^0.33.0"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "typescript": "^5.9.3",
    "tsx": "^4.19.1",
    "esbuild": "^0.25.0",
    "vitest": "^2.1.4",
    "prettier": "^3.6.2",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
